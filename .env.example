# Where scoping-form leads are delivered.
CONTACT_EMAIL=founders@gounbusy.com

# Required for email delivery. Without it, the form shows an email fallback;
# requests are logged for recovery but are NOT counted as conversions.
RESEND_API_KEY=
# Must be a domain verified in Resend.
LEAD_FROM_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX), from GA Admin > Data
# streams. The tag only loads on Vercel production; leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Review booking: a Calendly or Google Calendar appointment-schedule link. Unset = "Request a free review" and a request-received page.
# For Calendly, set its redirect to https://gounbusy.com/review/booked/confirmed with "pass event details" on.
NEXT_PUBLIC_REVIEW_BOOKING_URL=
